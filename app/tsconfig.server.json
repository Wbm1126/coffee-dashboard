{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["src/server", "src/domain", "src/lib", "src/storage", "src/import", "src/recommendation", "src/recommendation/*.json", "src/collectors", "src/exports"],
  "exclude": ["tests", "dist"]
}
