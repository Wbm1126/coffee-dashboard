{
  "name": "coffee-bean-dashboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,magenta \"cross-env NODE_ENV=development tsx watch src/server/start.ts\" \"vite\"",
    "setup": "playwright install chromium",
    "doctor": "tsx scripts/doctor.ts",
    "collect:smoke": "tsx scripts/collect-smoke.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:pdf": "vitest run tests/pdf",
    "test:pdf:visual": "tsx scripts/render-pdf-fixture.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "start": "node dist/server/start.js",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm run smoke:production"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jszip": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
